# Build output
build/
projects/*/build/
*.o *.elf *.bin *.map *.hex

# ARM toolchain (downloaded on demand)
tools/*
!tools/proto_client/
!tools/proto_client/**
downloads/

# TivaWare SDK (installed on first build; see sdk/README.md)
sdk/*
!sdk/README.md

# Legacy IDE DB at repo root (use build/ide-compile-db.json)
compile_commands.json

# IDE / Editor
.vs/
*.suo *.user *.db *.swp *.swo *~

# Windows junk
Thumbs.db Desktop.ini

# Python
__pycache__/
*.pyc

# Local scratch / runtime logs (do not commit)
tmp/
tools/proto_client/log/

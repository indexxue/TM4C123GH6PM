{
  "_format": "tm4c123-sysconfig-v1",
  "project": {
    "name": "TM4C123 Car Project",
    "mcu": "TM4C123GH6PM"
  },
  "system": {
    "clock_hz": 80000000
  },
  "gpio": [
    {
      "port": "A",
      "pin": 2,
      "label": "M1_IN1",
      "direction": "output",
      "_usage": "Motor 1 direction"
    },
    {
      "port": "A",
      "pin": 3,
      "label": "M1_IN2",
      "direction": "output",
      "_usage": "Motor 1 direction"
    },
    {
      "port": "A",
      "pin": 4,
      "label": "M2_IN1",
      "direction": "output",
      "_usage": "Motor 2 direction"
    },
    {
      "port": "A",
      "pin": 5,
      "label": "M2_IN2",
      "direction": "output",
      "_usage": "Motor 2 direction"
    },
    {
      "port": "A",
      "pin": 6,
      "label": "LINE1",
      "direction": "input",
      "_usage": "line sensor 1"
    },
    {
      "port": "A",
      "pin": 7,
      "label": "LINE2",
      "direction": "input",
      "_usage": "line sensor 2"
    },
    {
      "port": "B",
      "pin": 0,
      "label": "M3_PWM",
      "direction": "output",
      "_usage": "Timer2A T2CCP0"
    },
    {
      "port": "B",
      "pin": 1,
      "label": "M4_PWM",
      "direction": "output",
      "_usage": "Timer2B T2CCP1"
    },
    {
      "port": "B",
      "pin": 2,
      "label": "I2C_SCL",
      "direction": "input",
      "_usage": "I2C0 SCL (IMU+OLED)"
    },
    {
      "port": "B",
      "pin": 3,
      "label": "I2C_SDA",
      "direction": "input",
      "_usage": "I2C0 SDA (IMU+OLED)"
    },
    {
      "port": "B",
      "pin": 4,
      "label": "M3_PWM_ALT",
      "direction": "output",
      "_usage": "Timer1A T1CCP0 (spare)"
    },
    {
      "port": "B",
      "pin": 5,
      "label": "M4_PWM_ALT",
      "direction": "output",
      "_usage": "Timer1B T1CCP1 (spare)"
    },
    {
      "port": "B",
      "pin": 6,
      "label": "M1_PWM",
      "direction": "output",
      "_usage": "Timer0A T0CCP0, I2C5SCL"
    },
    {
      "port": "B",
      "pin": 7,
      "label": "M2_PWM",
      "direction": "output",
      "_usage": "Timer0B T0CCP1, I2C5SDA"
    },
    {
      "port": "C",
      "pin": 0,
      "label": "M4_ENCA",
      "direction": "input",
      "_usage": "Timer4A capture, SWCLK"
    },
    {
      "port": "C",
      "pin": 1,
      "label": "M4_ENCB",
      "direction": "input",
      "_usage": "Timer4B capture, SWDIO"
    },
    {
      "port": "C",
      "pin": 4,
      "label": "M3_IN1",
      "direction": "output",
      "_usage": "Motor 3 direction"
    },
    {
      "port": "C",
      "pin": 6,
      "label": "LINE3",
      "direction": "input",
      "_usage": "line sensor 3"
    },
    {
      "port": "C",
      "pin": 7,
      "label": "M3_IN2",
      "direction": "output",
      "_usage": "Motor 3 direction"
    },
    {
      "port": "D",
      "pin": 0,
      "label": "M4_IN1",
      "direction": "output",
      "_usage": "Motor 4 direction"
    },
    {
      "port": "D",
      "pin": 1,
      "label": "M4_IN2",
      "direction": "output",
      "_usage": "Motor 4 direction"
    },
    {
      "port": "D",
      "pin": 2,
      "label": "M1_ENCA",
      "direction": "input",
      "_usage": "WTimer3A capture"
    },
    {
      "port": "D",
      "pin": 3,
      "label": "M1_ENCB",
      "direction": "input",
      "_usage": "WTimer3B capture"
    },
    {
      "port": "D",
      "pin": 4,
      "label": "M2_ENCA",
      "direction": "input",
      "_usage": "WTimer4A capture"
    },
    {
      "port": "D",
      "pin": 5,
      "label": "M2_ENCB",
      "direction": "input",
      "_usage": "WTimer4B capture"
    },
    {
      "port": "D",
      "pin": 6,
      "label": "M3_ENCA",
      "direction": "input",
      "_usage": "WTimer5A capture"
    },
    {
      "port": "D",
      "pin": 7,
      "label": "M3_ENCB",
      "direction": "input",
      "_usage": "WTimer5B capture"
    },
    {
      "port": "E",
      "pin": 0,
      "label": "BAT_ADC",
      "direction": "input",
      "_usage": "ADC0 AIN0 battery"
    },
    {
      "port": "E",
      "pin": 2,
      "label": "LINE4",
      "direction": "input",
      "_usage": "line sensor 4"
    },
    {
      "port": "E",
      "pin": 3,
      "label": "BUZZER",
      "direction": "output",
      "_usage": "buzzer PWM"
    },
    {
      "port": "E",
      "pin": 4,
      "label": "ULTRA_TRIG",
      "direction": "output",
      "_usage": "HC-SR04 trigger"
    },
    {
      "port": "E",
      "pin": 5,
      "label": "ULTRA_ECHO",
      "direction": "input",
      "_usage": "HC-SR04 echo interrupt"
    },
    {
      "port": "F",
      "pin": 4,
      "label": "STATUS_LED",
      "direction": "output",
      "init": "low"
    },
    {
      "port": "E",
      "pin": 1,
      "label": "DBG_TX",
      "direction": "output"
    },
    {
      "port": "A",
      "pin": 0,
      "label": "BT_RX",
      "direction": "input"
    },
    {
      "port": "A",
      "pin": 1,
      "label": "BT_TX",
      "direction": "output"
    }
  ],
  "pwm": [
    {
      "name": "M1",
      "timer": "TIMER0",
      "channel": "A",
      "pin": "PB6",
      "frequency": 10000
    },
    {
      "name": "M2",
      "timer": "TIMER0",
      "channel": "B",
      "pin": "PB7",
      "frequency": 10000
    },
    {
      "name": "M3",
      "timer": "TIMER2",
      "channel": "A",
      "pin": "PB0",
      "frequency": 10000
    },
    {
      "name": "M4",
      "timer": "TIMER2",
      "channel": "B",
      "pin": "PB1",
      "frequency": 10000
    }
  ],
  "encoder": [
    {
      "name": "M1",
      "timer": "WTIMER3",
      "pin_a": "PD2",
      "pin_b": "PD3"
    },
    {
      "name": "M2",
      "timer": "WTIMER4",
      "pin_a": "PD4",
      "pin_b": "PD5"
    },
    {
      "name": "M3",
      "timer": "WTIMER5",
      "pin_a": "PD6",
      "pin_b": "PD7"
    },
    {
      "name": "M4",
      "timer": "TIMER5",
      "pin_a": "PC2",
      "pin_b": "PC3"
    }
  ],
  "uart": [
    {
      "name": "Bluetooth",
      "module": "UART0",
      "tx": "PA1",
      "rx": "PA0",
      "baud": 115200
    }
  ],
  "i2c": [
    {
      "name": "IMU_OLED",
      "module": "I2C0",
      "scl": "PB2",
      "sda": "PB3",
      "speed": 400000
    }
  ],
  "adc": [
    {
      "name": "Battery",
      "module": "ADC0",
      "channel": 0,
      "pin": "PE0"
    }
  ],
  "ssi": [
    {
      "name": "Magnetometer",
      "module": "SSI1",
      "clk": "PF2",
      "fss": "PF3",
      "rx": "PF0",
      "tx": "PF1",
      "mode": "master",
      "speed": 1000000
    }
  ],
  "uart_debug": [
    {
      "name": "Debug",
      "module": "UART7",
      "tx": "PE1",
      "baud": 115200
    }
  ],
  "dma": [
    {
      "name": "ADC_BAT",
      "module": "ADC0",
      "trigger": "timer",
      "chan": 0,
      "direction": "periph2mem"
    },
    {
      "name": "UART0_RX",
      "module": "UART0",
      "trigger": "uart_rx",
      "chan": 1,
      "direction": "periph2mem"
    }
  ]
}
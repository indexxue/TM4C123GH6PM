{
    "version": "2.0.0",
    "options": {
        "shell": {
            "executable": "powershell",
            "args": ["-NoLogo", "-ExecutionPolicy", "Bypass", "-Command"]
        }
    },
    "tasks": [
        {
            "label": "Build",
            "type": "shell",
            "command": "& { & \"${workspaceRoot}\\scripts\\build.ps1\" car-4wd }",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["relative", "${workspaceRoot}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Build factory",
            "type": "shell",
            "command": "& { & \"${workspaceRoot}\\scripts\\build.ps1\" factory }",
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated"
            },
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["relative", "${workspaceRoot}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            }
        },
        {
            "label": "Clean",
            "type": "shell",
            "command": "if (Test-Path \"${workspaceRoot}\\projects\\car-4wd\\build\") { Remove-Item \"${workspaceRoot}\\projects\\car-4wd\\build\" -Recurse -Force; Write-Host 'Cleaned car-4wd.' } else { Write-Host 'Nothing to clean.' }",
            "group": "build",
            "presentation": { "echo": true, "reveal": "always" }
        },
        {
            "label": "Rebuild",
            "type": "shell",
            "command": "if (Test-Path \"${workspaceRoot}\\projects\\car-4wd\\build\") { Remove-Item \"${workspaceRoot}\\projects\\car-4wd\\build\" -Recurse -Force }; & \"${workspaceRoot}\\scripts\\build.ps1\" car-4wd",
            "group": { "kind": "build", "isDefault": false },
            "presentation": { "echo": true, "reveal": "always" }
        },
        {
            "label": "Flash (UniFlash)",
            "type": "shell",
            "command": "& \"${workspaceRoot}\\scripts\\flash-uniflash.ps1\" -Target standalone",
            "group": "test",
            "presentation": { "echo": true, "reveal": "always", "focus": true }
        }
    ]
}
